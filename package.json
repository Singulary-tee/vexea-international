    "@openfeature/config-cat-web-provider": "^0.2.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@openfeature/web-sdk": "^1.10.0",
    "@sentry/browser": "^10.69.0",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@tailwindcss/vite": "^4.1.14",
