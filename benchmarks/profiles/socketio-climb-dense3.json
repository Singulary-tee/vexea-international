{
  "schemaVersion": 1,
  "id": "socketio-climb-dense3",
  "title": "Socket.IO Density Climb 3: 1 Match, 1 Player, 8 Bots, 8 Drones",
  "boundary": "server-process",
  "transport": "socketio",
  "server": {
    "command": ["node", "dist/server/server.cjs"],
    "buildCommand": ["npm", "run", "build"],
    "port": 3346,
    "readinessPath": "/",
    "env": {}
  },
  "map": {
    "id": "benchmark_synthetic",
    "mode": "synthetic",
    "allowFallback": true
  },
  "services": {
    "llm": "disabled",
    "persistence": "disabled",
    "observability": "disabled"
  },
  "instrumentation": "counters",
  "workload": {
    "rooms": 1,
    "clientsPerRoom": 1,
    "botsPerRoom": 8,
    "dronesPerRoom": 8,
    "projectilesPerRoom": 0,
    "durationMs": 12000,
    "warmupMs": 3000,
    "cooldownMs": 1000,
    "inputHz": 25,
    "reliableEventsPerSecond": 0,
    "firePerSecond": 0,
    "contact": "persistent",
    "seed": 20
  },
  "budgets": {
    "maxP95TickMs": 16.6,
    "minTickRate": 55,
    "maxDroppedTicks": 0,
    "maxRssBytes": 1073741824,
    "maxCpuPercent": 100,
    "maxP95RttMs": 250,
    "maxLossRate": 0.01,
    "maxNetworkBytesPerSecond": 104857600,
    "headroomPercent": 10
  },
  "trials": {
    "warmups": 1,
    "repetitions": 1,
    "confidenceLevel": 0.95
  }
}
