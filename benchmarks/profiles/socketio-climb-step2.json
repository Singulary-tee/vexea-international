{
  "schemaVersion": 1,
  "id": "socketio-climb-step2",
  "title": "Socket.IO Climb Step 2: 2 Matches, 2 Players, 4 Bots, 4 Drones, 4 Projectiles",
  "boundary": "server-process",
  "transport": "socketio",
  "server": {
    "command": ["node", "dist/server/server.cjs"],
    "buildCommand": ["npm", "run", "build"],
    "port": 3342,
    "readinessPath": "/",
    "env": {}
  },
  "map": {
    "id": "benchmark_synthetic",
    "mode": "synthetic",
    "allowFallback": true
  },
  "services": {
    "llm": "disabled",
    "persistence": "disabled",
    "observability": "disabled"
  },
  "instrumentation": "counters",
  "workload": {
    "rooms": 2,
    "clientsPerRoom": 1,
    "botsPerRoom": 2,
    "dronesPerRoom": 2,
    "projectilesPerRoom": 2,
    "durationMs": 12000,
    "warmupMs": 3000,
    "cooldownMs": 1000,
    "inputHz": 20,
    "reliableEventsPerSecond": 1,
    "firePerSecond": 1,
    "contact": "calm",
    "seed": 2
  },
  "budgets": {
    "maxP95TickMs": 16.6,
    "minTickRate": 55,
    "maxDroppedTicks": 0,
    "maxRssBytes": 1073741824,
    "maxCpuPercent": 100,
    "maxP95RttMs": 250,
    "maxLossRate": 0.01,
    "maxNetworkBytesPerSecond": 104857600,
    "headroomPercent": 10
  },
  "trials": {
    "warmups": 1,
    "repetitions": 1,
    "confidenceLevel": 0.95
  }
}
