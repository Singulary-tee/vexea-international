{
  "schemaVersion": 1,
  "id": "socketio-climb-dense2",
  "title": "Socket.IO Density Climb 2: 1 Match, 1 Player, 4 Bots, 4 Drones",
  "boundary": "server-process",
  "transport": "socketio",
  "server": {
    "command": ["node", "dist/server/server.cjs"],
    "buildCommand": ["npm", "run", "build"],
    "port": 3345,
    "readinessPath": "/",
    "env": {}
  },
  "map": {
    "id": "benchmark_synthetic",
    "mode": "synthetic",
    "allowFallback": true
  },
  "services": {
    "llm": "disabled",
    "persistence": "disabled",
    "observability": "disabled"
  },
  "instrumentation": "counters",
  "workload": {
    "rooms": 1,
    "clientsPerRoom": 1,
    "botsPerRoom": 4,
    "dronesPerRoom": 4,
    "projectilesPerRoom": 0,
    "durationMs": 12000,
    "warmupMs": 3000,
    "cooldownMs": 1000,
    "inputHz": 20,
    "reliableEventsPerSecond": 0,
    "firePerSecond": 0,
    "contact": "calm",
    "seed": 10
  },
  "budgets": {
    "maxP95TickMs": 16.6,
    "minTickRate": 55,
    "maxDroppedTicks": 0,
    "maxRssBytes": 1073741824,
    "maxCpuPercent": 100,
    "maxP95RttMs": 250,
    "maxLossRate": 0.01,
    "maxNetworkBytesPerSecond": 104857600,
    "headroomPercent": 10
  },
  "trials": {
    "warmups": 1,
    "repetitions": 1,
    "confidenceLevel": 0.95
  }
}
