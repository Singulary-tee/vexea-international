rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: Secure-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Client-side player persistent stats
    match /player_stats/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // Client-side matches_in_progress session locking
    match /matches_in_progress/{matchId} {
      allow read, write: if request.auth != null;
    }

    // Client-side user feedback submission
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }

    // Server Authoritative: Users scores & outcomes (Synced and certified by server authoritative loops)
    match /Users/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // Friends subcollection: Users/{userId}/friends/{friendId}
    match /Users/{userId}/friends/{friendId} {
      // PERMISSION REASON: A user is explicitly permitted to read their own friends subcollection to view friend statuses and pending requests.
      allow read: if request.auth != null && request.auth.uid == userId;

      // PERMISSION REASON: A user is permitted to write under their own subcollection (request.auth.uid == userId) for sending pending_sent, accepting, or deleting requests.
      // A user is also permitted to write under a target's subcollection strictly for their own friend entry (request.auth.uid == friendId) to deliver a pending_received request, set accepted status, or delete on decline.
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.uid == friendId
      );
    }

    // Server Authoritative: MatchInProgress tracking
    match /MatchInProgress/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if false; // Only manageable server-side via Firebase Admin SDK
    }
  }
}
