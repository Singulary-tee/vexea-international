rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny: Secure-by-default
    match /{document=**} {
      allow read, write: if false;
    }

    // Client-side player persistent stats
    match /player_stats/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }

    // Server Authoritative: matches_in_progress session locking (managed via server API)
    match /matches_in_progress/{matchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Client-side user feedback submission
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
    }

    // Server Authoritative: Users scores, loadouts & outcomes (Managed authoritatively by server endpoints)
    match /Users/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if false;
    }

    // Friends subcollection: Users/{userId}/friends/{friendId}
    match /Users/{userId}/friends/{friendId} {
      // PERMISSION REASON: Strict user-only access. A user may read or write only within their own subcollection (request.auth.uid == userId).
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Incoming Friend Requests Inbox: incomingRequests/{targetUid}/requests/{senderUid}
    match /incomingRequests/{targetUid}/requests/{senderUid} {
      // PERMISSION REASON: The recipient (targetUid) may read and delete incoming requests in their inbox.
      allow read, delete: if request.auth != null && request.auth.uid == targetUid;
      // PERMISSION REASON: The sender may create or update an incoming request entry in the target's inbox, provided senderUid matches their auth UID and they are not sending to themselves.
      allow create, update: if request.auth != null && request.resource.data.senderUid == request.auth.uid && targetUid != request.auth.uid;
    }

    // Outcome Notifications Inbox: outcomes/{senderUid}/notifications/{recipientUid}
    match /outcomes/{senderUid}/notifications/{recipientUid} {
      // PERMISSION REASON: The original sender (senderUid) may read and delete notifications in their outcome inbox once synced.
      allow read, delete: if request.auth != null && request.auth.uid == senderUid;
      // PERMISSION REASON: The recipient may create or update an outcome notification in the sender's inbox, provided from matches their auth UID and senderUid is not themselves.
      allow create, update: if request.auth != null && request.resource.data.from == request.auth.uid && senderUid != request.auth.uid;
    }

    // Server Authoritative: MatchInProgress tracking
    match /MatchInProgress/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow write: if false; // Only manageable server-side via Firebase Admin SDK
    }

    // Unique display name claim-and-lookup table: usernames/{key}
    match /usernames/{key} {
      // PERMISSION REASON: Public lookup for any authenticated user.
      allow read: if request.auth != null;
      // PERMISSION REASON: One-time claim. Create allowed only if doc does not exist and claimed UID matches auth UID.
      allow create: if request.auth != null && resource == null && request.resource.data.uid == request.auth.uid;
      // PERMISSION REASON: No update or delete permitted by any client, ever.
      allow update, delete: if false;
    }

    // Lobby Invites: lobbyInvites/{invitedUid}/pending/{lobbyId}
    match /lobbyInvites/{invitedUid}/pending/{lobbyId} {
      // PERMISSION REASON: The recipient (invitedUid) can read pending invites sent to them.
      allow read: if request.auth != null && request.auth.uid == invitedUid;
      // PERMISSION REASON: The inviter can create an invite in the recipient's inbox.
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      // PERMISSION REASON: The recipient or the inviter can delete the invite (for accepting/declining/expiring or cancelling).
      allow delete: if request.auth != null && (request.auth.uid == invitedUid || resource.data.fromUid == request.auth.uid);
    }
  }
}
